{
  "name": "ailin-yu-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "tokens": "node scripts/design-tokens.mjs",
    "tokens:check": "node scripts/design-tokens.mjs --check",
    "test:tokens": "node --test scripts/design-tokens.test.mjs",
    "test:work": "node --test scripts/home-gallery.test.mjs",
    "check": "pnpm tokens:check && pnpm test:tokens && pnpm test:work && tsc --noEmit",
    "build": "pnpm tokens && pnpm check && vite build && pnpm release:check",
    "preview": "vite preview --host 127.0.0.1",
    "ui:add": "shadcn add",
    "release:check": "node scripts/check-release.mjs",
    "prepare:deploy": "pnpm build && node scripts/prepare-deploy.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.62.0",
    "motion": "14.7.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
